# Copy to .env and adjust for your environment
DB_URL="mysql+asyncmy://root:root1234@localhost/test_db"
DB_NAME="test_db"
# JWT_SECRET="change-me-in-production"

# --- HTTP server ---
# REQUEST_TIMEOUT_SECONDS=30           # per-request timeout -> 504 if exceeded

# --- Security ---
# ALLOWED_ORIGINS='["http://localhost:8081","http://localhost:19006"]'  # CORS (comma list also accepted)
# RATE_LIMIT_MAX_REQUESTS=300          # general requests / RATE_LIMIT_WINDOW_SECONDS
# RATE_LIMIT_AUTH_MAX=10               # login/register attempts / window
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_EXEMPT_LOCALHOST=1        # don't throttle 127.0.0.1/::1 (dev only)
# PASSWORD_MIN_LENGTH=8
# PASSWORD_REQUIRE_DIGIT=1

# --- Scalability (connection pool) ---
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800
# DB_ECHO=0
# REDIS_URL="redis://localhost:6379/0" # future Redis-backed cache layer

# --- Observability ---
# LOG_LEVEL="INFO"                    # DEBUG | INFO | WARNING | ERROR
# LOG_DIR="backend/logs"              # structured JSON logs (rotating)
# LOG_FILE_MAX_BYTES=5242880          # 5 MB per file
# LOG_FILE_BACKUPS=5
# MONITORING_EXPOSE_LOGS=0            # set 1 to allow admins to tail /api/monitoring/logs

# --- Caching TTLs (seconds) ---
# CACHE_TTL_ZONES=60                  # zone restriction rules
# CACHE_TTL_PRICING=60                # fare rules (per vehicle type)
# CACHE_TTL_PLACES=600                # Nominatim place search/reverse results

# --- AI assistant (optional) ---
# AI_ENABLED=1
# AI_API_KEY=""                       # empty = offline FAQ mode (no external calls)
# AI_BASE_URL="https://api.openai.com/v1"   # any OpenAI-compatible endpoint
# AI_MODEL="gpt-4o-mini"
# AI_TIMEOUT=12

# --- Backup (scripts/backup_db.sh) ---
# MYSQL_HOST=127.0.0.1
# MYSQL_USER=root
# MYSQL_PASSWORD=root1234
# BACKUP_KEEP_DAYS=14

# --- Driver verification ---
# AUTO_VERIFY_DRIVERS=1              # 0 = force manual admin review of every driver
# VERIFICATION_REQUIRED_DOCS=1       # min uploaded ID/license docs before auto-verify

# Government ID cross-check (NIN/BVN) - SmileID Enhanced KYC.
# Get credentials: sign up at https://portal.usesmileid.com, then
# Developers > Security Settings > Sandbox/Production toggle > Create Credential.
#   SMILEDID_ENV=sandbox            # free test identities; use "production" for live lookups
# SMILEDID_PARTNER_ID="your_partner_id"
# SMILEDID_API_KEY="your_api_key"
# SMILEDID_POLL_INTERVAL=5          # seconds between async job status polls
# SMILEDID_POLL_TIMEOUT=75          # max seconds to wait for a terminal verdict
# PRIVACY_POLICY_URL="https://naijamove.com/privacy"

# In-house face liveness + face match (no provider needed).
# ONNX models (YuNet + SFace) auto-download on first use into backend/models/;
# pre-fetch them with: python3 scripts/download_biometric_models.py
# BIOMETRIC_MODELS_DIR="backend/models"
# FACE_MATCH_MIN_SCORE=0.45         # min selfie-vs-ID-document similarity (0..1)
# LIVENESS_MIN_DURATION_SECONDS=1.2 # min clip length
# LIVENESS_MIN_FACE_RATIO=0.8       # fraction of frames that must show a face
# LIVENESS_MIN_MOTION=0.02          # min normalized face movement
# LIVENESS_CHALLENGE_MIN_DEVIATION=0.08  # min head-turn/nod deviation per challenge step
# LIVENESS_CHALLENGE_STEP_SECONDS=1.5    # time per random challenge instruction
# LIVENESS_CHALLENGE_LEAD_SECONDS=0.8    # lead-in before each instruction window
# LIVENESS_CHALLENGE_STILL_MAX=0.12      # max deviation while told to hold still
# LIVENESS_CHALLENGE_TTL_SECONDS=300     # how long a challenge stays valid
# MAX_UPLOAD_BYTES=15728640         # 15 MB (liveness clips)

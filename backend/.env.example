# Copy to .env and adjust for your environment
DB_URL="mysql+asyncmy://root:root1234@localhost/test_db"
DB_NAME="test_db"
# JWT_SECRET="change-me-in-production"

# --- HTTP server ---
# REQUEST_TIMEOUT_SECONDS=30           # per-request timeout -> 504 if exceeded

# --- Security ---
# ALLOWED_ORIGINS='["http://localhost:8081","http://localhost:19006"]'  # CORS (comma list also accepted)
# RATE_LIMIT_MAX_REQUESTS=300          # general requests / RATE_LIMIT_WINDOW_SECONDS
# RATE_LIMIT_AUTH_MAX=10               # login/register attempts / window
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_EXEMPT_LOCALHOST=1        # don't throttle 127.0.0.1/::1 (dev only)
# PASSWORD_MIN_LENGTH=8
# PASSWORD_REQUIRE_DIGIT=1

# --- Scalability (connection pool) ---
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800
# DB_ECHO=0
# REDIS_URL="redis://localhost:6379/0" # future Redis-backed cache layer

# --- Observability ---
# LOG_LEVEL="INFO"                    # DEBUG | INFO | WARNING | ERROR
# LOG_DIR="backend/logs"              # structured JSON logs (rotating)
# LOG_FILE_MAX_BYTES=5242880          # 5 MB per file
# LOG_FILE_BACKUPS=5
# MONITORING_EXPOSE_LOGS=0            # set 1 to allow admins to tail /api/monitoring/logs

# --- Caching TTLs (seconds) ---
# CACHE_TTL_ZONES=60                  # zone restriction rules
# CACHE_TTL_PRICING=60                # fare rules (per vehicle type)
# CACHE_TTL_PLACES=600                # Nominatim place search/reverse results

# --- AI assistant (optional) ---
# AI_ENABLED=1
# AI_API_KEY=""                       # empty = offline FAQ mode (no external calls)
# AI_BASE_URL="https://api.openai.com/v1"   # any OpenAI-compatible endpoint
# AI_MODEL="gpt-4o-mini"
# AI_TIMEOUT=12

# --- Backup (scripts/backup_db.sh) ---
# MYSQL_HOST=127.0.0.1
# MYSQL_USER=root
# MYSQL_PASSWORD=root1234
# BACKUP_KEEP_DAYS=14

# Copy to .env and set the URL of the running backend (FastAPI).
# Backend port is 8001 (8000 is used by an unrelated local app).
# On a real device via Expo Go, use your computer's LAN IP, e.g. http://192.168.1.130:8001
# (find it with `ipconfig getifaddr en0`). Leave unset to auto-derive from Expo hostUri.
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.130:8001
